generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TareaMantenimiento {
  id             Int       @id @default(autoincrement())
  titulo         String
  descripcion    String?
  estado         String    @default("pendiente")
  unidad_id      Int?
  asignado_id    Int?
  /// Alternativa a `asignado_id`: la tarea la hace un proveedor externo (directorio de la administradora).
  proveedor_id   Int?
  creado_por_id  Int?
  fecha_creacion DateTime  @default(now())
  fecha_cierre   DateTime?
  proveedor      Proveedor? @relation(fields: [proveedor_id], references: [id], onDelete: SetNull)
  asignado       Usuario?  @relation("TareaAsignado", fields: [asignado_id], references: [id])
  creado_por     Usuario?  @relation("TareaCreador", fields: [creado_por_id], references: [id])
  unidad         Unidad?   @relation(fields: [unidad_id], references: [id])
}

model Usuario {
  id                Int                    @id @default(autoincrement())
  nombre            String
  email             String                 @unique
  telefono          String?
  rol               String?
  password_hash     String?
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  pagos             Pago[]                 @relation("PagoUsuario")
  recibosCreados    Recibo[]               @relation("UsuarioCreadorRecibo")
  tareasAsignadas   TareaMantenimiento[]   @relation("TareaAsignado")
  tareasCreadas     TareaMantenimiento[]   @relation("TareaCreador")
  unidades          Unidad[]               @relation("PropietarioUnidad")
  unidadesInquilino Unidad[]               @relation("InquilinoUnidad")
  auditorias        Auditoria[]
  clavesIntegracion ClaveIntegracion[]
  gatewaysCreados   GatewayIA[]            @relation("GatewaysCreados")
  sesiones          Sesion[]
  empresa_id        Int?
  empresa           EmpresaAdministradora? @relation(fields: [empresa_id], references: [id])
  complejo_id       Int?
  complejo          ComplejoHabitacional?  @relation(fields: [complejo_id], references: [id])
  pagosValidados    Pago[]                 @relation("PagoValidador")
  pagosConformes    Pago[]                 @relation("PagoConformidad")
  comprobantesSubidos ArchivoComprobante[]
  aviso_email       Boolean                @default(true)
  aviso_whatsapp    Boolean                @default(false)
  notificaciones    Notificacion[]
  cargo_junta       String?
  estructura_id     Int?
  estructura        Estructura?            @relation("JuntaEstructura", fields: [estructura_id], references: [id], onDelete: SetNull)
  mediosPagoCreados MedioPago[]
  /// Cargo en la junta vigente y gestiones pasadas (`cargo_junta`/`estructura_id` son el reflejo de la vigente: ver `sincronizarCargos`).
  miembrosJunta     MiembroJunta[]
  juntasCreadas     JuntaDirectiva[]
  comunicadosPublicados Comunicado[]
  conversacionesIA  ConversacionIA[]
  tokensApi         TokenApi[]
  canalesVinculados CanalVinculado[]
  codigosVinculacion CodigoVinculacion[]
  canalPendientes   CanalPendiente[]
  /// false sólo en cuentas creadas por el registro público hasta que abren el enlace del correo. Las cuentas existentes y las que crea el superadmin quedan en true.
  correo_verificado Boolean                @default(true)
  /// Versión de los Términos y la Política de privacidad que aceptó al registrarse, y cuándo. Nulos en las cuentas anteriores y en las que crea el superadmin.
  terminos_version      String?
  terminos_aceptados_at DateTime?
  tokensVerificacion TokenVerificacionCorreo[]
  invitaciones      TokenInvitacion[]      @relation("InvitacionDeUsuario")
  invitacionesHechas TokenInvitacion[]     @relation("InvitacionCreadaPor")
  pagosSuscripcionRegistrados PagoSuscripcion[] @relation("PagoSuscripcionRegistrador")
  egresosRegistrados EgresoBlock[] @relation("EgresoRegistrador")
  egresosConformes EgresoBlock[] @relation("EgresoConformidad")
  movimientosCentral MovimientoCentral[]
  lecturasAguaRegistradas LecturaAgua[]
  imagenesReciboSubidas ImagenRecibo[]
}

model EmpresaAdministradora {
  id                  Int                    @id @default(autoincrement())
  nombre              String
  ruc                 String?
  direccion           String?
  telefono            String?
  email               String?
  representante_legal String?
  fecha_inicio        DateTime?
  fecha_fin           DateTime?
  estado              String?                @default("activa")
  whatsapp_instance   String?
  whatsapp_token      String?
  /// País (ISO 3166-1 alfa-2, `src/lib/paises.ts`) que se propone a sus condominios nuevos.
  pais                String                 @default("PE")
  /// Cuenta de la empresa administradora a la que el tesorero de cada block paga el concepto de administración (cierre del mes). Todo opcional.
  cuenta_banco        String?
  cuenta_tipo         String?
  cuenta_numero       String?
  cuenta_cci          String?
  cuenta_titular      String?
  complejos           ComplejoHabitacional[]
  contratos           ContratoAdministracion[]
  proveedores         Proveedor[]
  conceptos           Concepto[]
  recibos             Recibo[]
  unidades            Unidad[]
  usuarios            Usuario[]
  canalesVinculados   CanalVinculado[]
  canalWebhook        CanalWebhook?
  pagosSuscripcion    PagoSuscripcion[]
  /// Logo que sale al pie del recibo impreso.
  imagenRecibo        ImagenRecibo?
}

model ComplejoHabitacional {
  id          Int                    @id @default(autoincrement())
  nombre      String
  tipo        String
  direccion   String?
  empresa_id  Int?
  descripcion String?
  /// País (ISO 3166-1 alfa-2) y moneda (ISO 4217) del condominio, del catálogo `src/lib/paises.ts`. Todo monto del condominio (recibos, pagos, mora) va en esa moneda; con recibos emitidos ya no se cambia.
  pais        String                 @default("PE")
  moneda      String                 @default("PEN")
  /// Zona horaria IANA del condominio («America/Lima»): el «hoy» de sus vencimientos, mora, avisos programados y resumen es el de esa zona (con horario de verano donde lo hay).
  zona_horaria String                @default("America/Lima")
  empresa     EmpresaAdministradora? @relation(fields: [empresa_id], references: [id])
  estructuras Estructura[]
  recibos     Recibo[]
  unidades    Unidad[]
  usuarios    Usuario[]
  mediosPago  MedioPago[]
  juntas      JuntaDirectiva[]
  contratos   ContratoAdministracion[]
  proveedores ProveedorComplejo[]
  comunicados Comunicado[]
  egresosBlock EgresoBlock[]
  movimientosCentral MovimientoCentral[]
  /// Si está activa, un comprobante que la IA lee como «coincide» (confianza alta, sin duplicados) valida el pago solo. Nunca rechaza.
  validacion_automatica_ia Boolean @default(false)
  /// Mora (en la moneda del condominio) que se agrega, en el recibo del mes siguiente, a la unidad que pagó fuera de fecha. 0 = sin mora.
  mora_monto  Decimal @default(20.00)
  /// Recibo impreso: notas de pago (texto libre, una línea por renglón) y contacto de la administración. Todo opcional: si falta, el bloque se omite.
  notas_pago    String?
  admin_nombre  String?
  admin_celular String?
  admin_correo  String?
  /// Foto de cabecera del recibo impreso (los bytes viven en `ImagenRecibo`, nunca en esta fila).
  imagenRecibo  ImagenRecibo?
  suscripcion SuscripcionCondominio?
  pagosSuscripcion PagoSuscripcion[]
  consumosMensuales ConsumoMensual[]
}

/// Quién administra un condominio y desde cuándo. Un solo contrato vigente (`fecha_fin` null) por condominio; `ComplejoHabitacional.empresa_id` es la empresa de ese contrato.
model ContratoAdministracion {
  id            Int                   @id @default(autoincrement())
  complejo_id   Int
  empresa_id    Int
  fecha_inicio  DateTime
  fecha_fin     DateTime?
  observaciones String?
  created_at    DateTime              @default(now())
  complejo      ComplejoHabitacional  @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  empresa       EmpresaAdministradora @relation(fields: [empresa_id], references: [id])

  @@index([complejo_id, fecha_fin])
  @@index([empresa_id])
}

/// Proveedor externo de la administradora (ascensores, gasfitería, pintura…). Sólo ficha: no inicia sesión. Se asigna a tareas de mantenimiento.
model Proveedor {
  id              Int                    @id @default(autoincrement())
  empresa_id      Int
  razon_social    String
  ruc             String?
  rubro           String
  contacto_nombre String?
  telefono        String?
  email           String?
  notas           String?
  /// Cuenta a la que la junta del block le paga (cierre del mes). Todo opcional.
  cuenta_banco    String?
  cuenta_tipo     String?
  cuenta_numero   String?
  cuenta_cci      String?
  cuenta_titular  String?
  /// Si los vecinos (propietarios e inquilinos) de sus condominios ven este proveedor en «Proveedores». Apagado por defecto: lo decide la administración o la junta.
  visible_vecinos Boolean                @default(false)
  activo          Boolean                @default(true)
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt
  empresa         EmpresaAdministradora  @relation(fields: [empresa_id], references: [id])
  complejos       ProveedorComplejo[]
  tareas          TareaMantenimiento[]
  conceptos       Concepto[]
  egresosBlock    EgresoBlock[]
  movimientosCentral MovimientoCentral[]

  @@index([empresa_id, rubro])
}

/// Condominios que atiende un proveedor.
model ProveedorComplejo {
  proveedor_id Int
  complejo_id  Int
  proveedor    Proveedor            @relation(fields: [proveedor_id], references: [id], onDelete: Cascade)
  complejo     ComplejoHabitacional @relation(fields: [complejo_id], references: [id], onDelete: Cascade)

  @@id([proveedor_id, complejo_id])
}

model Estructura {
  id          Int                   @id @default(autoincrement())
  nombre      String?
  tipo        String
  padre_id    Int?
  complejo_id Int?
  created_at  DateTime              @default(now())
  updated_at  DateTime              @updatedAt
  complejo    ComplejoHabitacional? @relation(fields: [complejo_id], references: [id])
  padre       Estructura?           @relation("EstructuraPadre", fields: [padre_id], references: [id])
  hijos       Estructura[]          @relation("EstructuraPadre")
  pisos       Piso[]
  unidades    Unidad[]
  juntaUsuarios Usuario[]           @relation("JuntaEstructura")
  mediosPago  MedioPago[]
  juntas      JuntaDirectiva[]
  recibos     Recibo[]
  comunicados Comunicado[]
  egresosBlock EgresoBlock[]
  /// «Correo del block» al que se envían los vouchers (sale en el recibo impreso).
  correo_vouchers String?
}

model Piso {
  id            Int         @id @default(autoincrement())
  numero        Int?
  estructura_id Int?
  estructura    Estructura? @relation(fields: [estructura_id], references: [id])
  unidades      Unidad[]
}

model Unidad {
  id                     Int                    @id @default(autoincrement())
  codigo                 String
  tipo                   String
  estructura_id          Int?
  piso_id                Int?
  complejo_id            Int?
  descripcion            String?
  propietario_id         Int?
  inquilino_id           Int?
  empresa_id             Int?
  estado                 String?                @default("activa")
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  reciboConceptoUnidades ReciboConceptoUnidad[]
  tareasMantenimiento    TareaMantenimiento[]
  lecturasAgua           LecturaAgua[]
  complejo               ComplejoHabitacional?  @relation(fields: [complejo_id], references: [id])
  empresa                EmpresaAdministradora? @relation(fields: [empresa_id], references: [id])
  estructura             Estructura?            @relation(fields: [estructura_id], references: [id])
  piso                   Piso?                  @relation(fields: [piso_id], references: [id])
  propietario            Usuario?               @relation("PropietarioUnidad", fields: [propietario_id], references: [id])
  inquilino              Usuario?               @relation("InquilinoUnidad", fields: [inquilino_id], references: [id])
}

model Concepto {
  id              Int                    @id @default(autoincrement())
  nombre          String
  descripcion     String?
  tipo_monto      String?                @default("fijo")
  empresa_id      Int?
  activo          Boolean                @default(true)
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt
  /// Adónde va lo que se cobra con este concepto al cerrar el mes: administradora | central | servicio | proveedor | ahorro_block. null = sin clasificar (no entra al cierre).
  destino         String?
  /// Sólo con `destino = proveedor`: quién presta el servicio contratado (ascensor, bombas…). Informativo.
  proveedor_id    Int?
  proveedor       Proveedor?             @relation(fields: [proveedor_id], references: [id], onDelete: SetNull)
  empresa         EmpresaAdministradora? @relation(fields: [empresa_id], references: [id])
  reciboConceptos ReciboConcepto[]
  egresosBlock    EgresoBlock[]
}

model Recibo {
  id                Int                    @id @default(autoincrement())
  descripcion       String?
  fecha_emision     DateTime
  fecha_vencimiento DateTime
  mes               Int
  anio              Int
  estado            String?                @default("emitido")
  empresa_id        Int?
  complejo_id       Int?
  /// Torre/block del recibo. null = condominio sin torres, recibo «general» o recibo viejo que mezcla torres.
  estructura_id     Int?
  archivo_excel_url String?
  /// Fecha en que se corta el agua a quien no pagó (sale en el recibo impreso). Opcional.
  fecha_corte_agua  DateTime?              @db.Date
  creado_por_id     Int?
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  complejo          ComplejoHabitacional?  @relation(fields: [complejo_id], references: [id])
  estructura        Estructura?            @relation(fields: [estructura_id], references: [id])
  creado_por        Usuario?               @relation("UsuarioCreadorRecibo", fields: [creado_por_id], references: [id])
  empresa           EmpresaAdministradora? @relation(fields: [empresa_id], references: [id])
  reciboConceptos   ReciboConcepto[]
  lecturasAgua      LecturaAgua[]

  /// Un recibo por (condominio, torre, mes, año). NO es @@unique a propósito: (1) Postgres no compara NULL con NULL, así que no cubriría los recibos
  /// sin torre; (2) un @@unique nuevo hace que `prisma db push` exija --accept-data-loss y el contenedor arranca con `db push` a secas (abortaría).
  /// La unicidad la impone el código (`services/reciboUnico.ts`: candado por periodo + comprobación en la misma transacción); aquí sólo el índice.
  @@index([complejo_id, estructura_id, mes, anio])
}

model ReciboConcepto {
  id                     Int                    @id @default(autoincrement())
  recibo_id              Int?
  concepto_id            Int?
  monto                  Decimal
  es_recargo             Boolean                @default(false)
  orden                  Int?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  concepto               Concepto?              @relation(fields: [concepto_id], references: [id])
  recibo                 Recibo?                @relation(fields: [recibo_id], references: [id])
  reciboConceptoUnidades ReciboConceptoUnidad[]
}

model ReciboConceptoUnidad {
  id                 Int             @id @default(autoincrement())
  recibo_concepto_id Int?
  unidad_id          Int?
  monto              Decimal
  estado_pago        String?         @default("pendiente")
  fecha_pago         DateTime?
  url_voucher        String?
  observaciones      String?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  pagos              Pago[]
  reciboConcepto     ReciboConcepto? @relation(fields: [recibo_concepto_id], references: [id])
  unidad             Unidad?         @relation(fields: [unidad_id], references: [id])
}

model Pago {
  id                        Int                   @id @default(autoincrement())
  recibo_concepto_unidad_id Int?
  monto                     Decimal
  fecha_pago                DateTime              @default(now())
  usuario_id                Int?
  metodo_pago               String?
  referencia                String?
  observaciones             String?
  created_at                DateTime              @default(now())
  reciboConceptoUnidad      ReciboConceptoUnidad? @relation(fields: [recibo_concepto_unidad_id], references: [id])
  usuario                   Usuario?              @relation("PagoUsuario", fields: [usuario_id], references: [id])
  estado_validacion         String                @default("validado")
  validado_por_id           Int?
  validado_at               DateTime?
  motivo_rechazo            String?
  validado_por              Usuario?              @relation("PagoValidador", fields: [validado_por_id], references: [id], onDelete: SetNull)
  /// Conformidad del tesorero de la junta: «el dinero llegó a la cuenta». Quién y cuándo; null = aún no la da. La administradora la ve al validar (no la bloquea).
  conformidad_at            DateTime?
  conformidad_por_id        Int?
  conformidad_por           Usuario?              @relation("PagoConformidad", fields: [conformidad_por_id], references: [id], onDelete: SetNull)
  comprobante               ArchivoComprobante?
  validado_por_ia           Boolean               @default(false)
  evaluacion                EvaluacionComprobante?
  /// Pago del mantenimiento completo: los `Pago` de un mismo (recibo, unidad) comparten este identificador. Null = pago suelto por cargo.
  grupo                     String?
  /// El pago que representa al grupo: lleva el comprobante y la evaluación de la IA (que compara contra el TOTAL del grupo).
  grupo_principal           Boolean               @default(false)
  /// De dónde salió `fecha_pago`: declarada | voucher (leída por la IA) | no_leida | invalida (leída pero futura o muy antigua) | manual. Ver `services/fechaVoucher.ts`.
  fecha_origen              String                @default("declarada")
  /// La fecha que declaró quien registró el pago, guardada al aplicar la del voucher (para restaurarla si un voucher posterior no se lee).
  fecha_declarada           DateTime?

  @@index([estado_validacion])
  @@index([grupo])
}

model Auditoria {
  id         Int      @id @default(autoincrement())
  usuario_id Int?
  accion     String
  entidad    String
  entidad_id Int?
  detalle    Json?
  ip         String?
  created_at DateTime @default(now())
  usuario    Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([entidad, accion])
  @@index([usuario_id])
  @@index([created_at])
}

model ClaveIntegracion {
  id                Int       @id @default(autoincrement())
  proveedor         String
  etiqueta          String    @default("principal")
  api_key_enc       String
  ultimos4          String
  modelo            String?
  habilitada        Boolean   @default(true)
  estado            String    @default("sin_probar")
  estado_detalle    String?
  probada_at        DateTime?
  ultimo_uso_at     DateTime?
  actualizado_por_id Int?
  actualizado_por   Usuario?  @relation(fields: [actualizado_por_id], references: [id], onDelete: SetNull)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Proveedor «de reserva»: sólo se usa cuando las rutas normales están agotadas.
  reserva           Boolean   @default(false)
  /// Aviso para la pantalla cuando el modelo fijado dejó de existir y la clave volvió a elección automática.
  aviso_modelo      String?
  modelos           ModeloIA[]
  sincronizaciones  SyncModelosIA[]
  /// Sólo las claves de un gateway propio (`proveedor = 'gateway'`) lo llevan; las del catálogo fijo, no.
  gateway_id        Int?
  gateway           GatewayIA? @relation(fields: [gateway_id], references: [id], onDelete: Cascade)

  /// Las claves de un gateway guardan su etiqueta como `g<id>:<etiqueta>` para que esta unicidad sirva sin cambiarla (cambiarla hace fallar `db push` en producción).
  @@unique([proveedor, etiqueta])
  @@index([gateway_id])
}

/// Gateway propio compatible con OpenAI. Sólo el superadmin lo crea; su dominio debe estar en `DominioGatewayPermitido`.
model GatewayIA {
  id                 Int       @id @default(autoincrement())
  nombre             String    @unique
  base_url           String
  modelo_por_defecto String?
  modelo_vision      String?
  vision             Boolean   @default(false)
  /// Posición en la rotación frente al catálogo (menor = antes). El catálogo usa 1-14.
  prioridad          Int       @default(20)
  /// Posición SÓLO para leer comprobantes (menor = antes). null = usa `prioridad`. No cambia la rotación del chat.
  prioridad_vision   Int?
  habilitado         Boolean   @default(true)
  creado_por_id      Int?
  creado_por         Usuario?  @relation("GatewaysCreados", fields: [creado_por_id], references: [id], onDelete: SetNull)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  claves             ClaveIntegracion[]
}

/// Dominios (host exacto) a los que un gateway u OCR público puede apuntar. Sólo el superadmin la edita; no es la barrera de fondo (esa es la red).
model DominioGatewayPermitido {
  id            Int      @id @default(autoincrement())
  dominio       String   @unique
  creado_por_id Int?
  created_at    DateTime @default(now())
}

/// Servicio de OCR de comprobantes (una sola fila, id = 1). `modo`: 'interno' (destino de la lista FIJA del código) o 'publico' (https con las barreras de los gateways).
model ConfiguracionOcr {
  id                 Int      @id @default(1)
  modo               String
  destino_interno    String?
  base_url           String?
  api_key_enc        String?
  ultimos4           String?
  habilitado         Boolean  @default(true)
  actualizado_por_id Int?
  updated_at         DateTime @updatedAt
}

/// Bot de Telegram GLOBAL de House (una sola fila, id = 1). El token va cifrado con el Llavero (AAD `telegram:bot`); del secreto del webhook sólo se guarda su hash.
model ConfiguracionTelegram {
  id                    Int       @id @default(1)
  token_enc             String?
  ultimos4              String?
  /// @usuario del bot (sin «@»), tal como lo informa `getMe`.
  bot_usuario           String?
  bot_nombre            String?
  habilitado            Boolean   @default(false)
  secreto_hash          String?
  webhook_url           String?
  webhook_registrado_at DateTime?
  actualizado_por_id    Int?
  updated_at            DateTime  @updatedAt
}

/// Sesión del lado del servidor: la cookie `house_sesion` lleva un token opaco; aquí sólo se guarda su sha256.
model Sesion {
  id            String    @id @default(cuid())
  usuario_id    Int
  usuario       Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  token_hash    String    @unique
  csrf_token    String
  ip            String?
  user_agent    String?
  created_at    DateTime  @default(now())
  ultimo_uso_at DateTime  @default(now())
  expira_at     DateTime
  revocada_at   DateTime?

  @@index([usuario_id])
  @@index([expira_at])
}

model ArchivoComprobante {
  id             Int      @id @default(autoincrement())
  pago_id        Int      @unique
  nombre         String
  tipo_mime      String
  tamano         Int
  sha256         String
  datos          Bytes
  subido_por_id  Int?
  created_at     DateTime @default(now())
  pago           Pago     @relation(fields: [pago_id], references: [id], onDelete: Cascade)
  subido_por     Usuario? @relation(fields: [subido_por_id], references: [id], onDelete: SetNull)
}

/// Aviso por correo o WhatsApp: se encola `pendiente` y el planificador lo envía. Único por usuario, canal, tipo y referencia.
model Notificacion {
  id             Int       @id @default(autoincrement())
  usuario_id     Int
  canal          String
  tipo           String
  asunto         String
  cuerpo         String
  estado         String    @default("pendiente")
  intentos       Int       @default(0)
  error          String?
  programada_para DateTime @default(now())
  enviada_at     DateTime?
  ref_entidad    String?
  ref_id         Int?
  created_at     DateTime  @default(now())
  usuario        Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, canal, tipo, ref_entidad, ref_id])
  @@index([estado, programada_para])
  @@index([usuario_id])
  @@index([created_at])
}

/// Cuenta bancaria, Yape/Plin (con QR) o cuenta recaudadora (el vecino paga desde «Pago de servicios» de su banco) donde los vecinos pagan; la define la administradora o la junta del block.
/// Comunicado de la administración o la junta a los propietarios e inquilinos de un condominio (`estructura_id` null) o de un block. El cuerpo es texto plano: nunca se pinta como HTML.
model Comunicado {
  id               Int                  @id @default(autoincrement())
  complejo_id      Int
  /// null = todo el condominio; si no, un block/torre de ese condominio.
  estructura_id    Int?
  titulo           String
  cuerpo           String
  autor_id         Int?
  /// Sólo se usan al crear: editar nunca reenvía.
  enviar_correo    Boolean              @default(false)
  enviar_whatsapp  Boolean              @default(false)
  fijado           Boolean              @default(false)
  archivado_at     DateTime?
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt
  complejo         ComplejoHabitacional @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  estructura       Estructura?          @relation(fields: [estructura_id], references: [id], onDelete: Cascade)
  autor            Usuario?             @relation(fields: [autor_id], references: [id], onDelete: SetNull)

  @@index([complejo_id, archivado_at])
  @@index([complejo_id, estructura_id])
}

model MedioPago {
  id                Int                   @id @default(autoincrement())
  complejo_id       Int
  estructura_id     Int?
  tipo              String
  banco             String?
  /// Nombre de la entidad cuando `banco` es «Otro» (obligatorio al crear o editar; un medio antiguo puede no tenerlo).
  banco_otro        String?
  tipo_cuenta       String?
  numero_cuenta     String?
  cci               String?
  /// PEN | USD. Sólo informa al vecino: nada se convierte.
  moneda            String                @default("PEN")
  /// Recaudación: nombre del servicio tal como aparece en «Pago de servicios» de la app del banco.
  servicio          String?
  /// Recaudación: qué código escribe el vecino: departamento | dni | otro.
  codigo_pago       String?
  /// Recaudación con `codigo_pago = otro`: qué debe escribir el vecino.
  codigo_instruccion String?
  titular           String
  documento_titular String?
  celular           String?
  qr_nombre         String?
  qr_tipo_mime      String?
  qr_datos          Bytes?
  activo            Boolean               @default(true)
  orden             Int                   @default(0)
  creado_por_id     Int?
  /// Junta (gestión) a la que pertenece la cuenta. Null = medio anterior a las juntas o de un block que aún no tiene junta registrada.
  junta_id          Int?
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt
  complejo          ComplejoHabitacional  @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  estructura        Estructura?           @relation(fields: [estructura_id], references: [id], onDelete: Cascade)
  creado_por        Usuario?              @relation(fields: [creado_por_id], references: [id], onDelete: SetNull)
  junta             JuntaDirectiva?       @relation(fields: [junta_id], references: [id], onDelete: SetNull)

  @@index([complejo_id, estructura_id])
  @@index([junta_id])
}

/// Junta directiva de un block (o de todo el condominio si `estructura_id` es null) durante una gestión: de `desde` a `hasta`.
/// `hasta` null = vigente; hay una sola vigente por (condominio, block) (lo garantiza `services/juntas.ts` con el condominio bloqueado, Prisma no tiene índices parciales).
/// Su cuenta de cobro son sus `mediosPago`: la cuenta de la junta ES el medio de pago del block.
model JuntaDirectiva {
  id            Int                  @id @default(autoincrement())
  complejo_id   Int
  estructura_id Int?
  /// Fechas de calendario (00:00 UTC), como las de los recibos.
  desde         DateTime
  hasta         DateTime?
  /// Correo de la junta: ahí llegan los vouchers de los vecinos (reemplaza a `Estructura.correo_vouchers`, que queda de respaldo).
  correo        String?
  notas         String?
  creado_por_id Int?
  created_at    DateTime             @default(now())
  updated_at    DateTime             @updatedAt
  complejo      ComplejoHabitacional @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  estructura    Estructura?          @relation(fields: [estructura_id], references: [id], onDelete: Cascade)
  creado_por    Usuario?             @relation(fields: [creado_por_id], references: [id], onDelete: SetNull)
  miembros      MiembroJunta[]
  mediosPago    MedioPago[]

  @@index([complejo_id, estructura_id, hasta])
}

/// Un miembro de una gestión. Un solo presidente y un solo tesorero por junta, y una persona en una sola junta vigente (lo exige `services/juntas.ts`).
model MiembroJunta {
  id         Int            @id @default(autoincrement())
  junta_id   Int
  usuario_id Int
  /// presidente | tesorero | secretario | vocal
  cargo      String
  created_at DateTime       @default(now())
  junta      JuntaDirectiva @relation(fields: [junta_id], references: [id], onDelete: Cascade)
  usuario    Usuario        @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([junta_id, usuario_id])
  @@index([usuario_id])
}

/// Lectura del contómetro de agua de un departamento en el recibo de su torre del mes (lo que el recibo impreso llama «detalle del consumo de agua»).
/// Consumo m³ = actual − anterior (3 decimales); monto S/ = m³ × factor (2 decimales). No cambia ningún cargo: sólo se cruza con el concepto «AGUA DPTO».
model LecturaAgua {
  id                Int      @id @default(autoincrement())
  unidad_id         Int
  recibo_id         Int
  fecha_anterior    DateTime @db.Date
  lectura_anterior  Decimal  @db.Decimal(12, 3)
  fecha_actual      DateTime @db.Date
  lectura_actual    Decimal  @db.Decimal(12, 3)
  /// S/ por m³.
  factor            Decimal  @db.Decimal(10, 4)
  /// Foto del contómetro (≤ 2 MB, JPG/PNG/WebP). Nunca sale en las listas: sólo por su endpoint con alcance.
  foto_nombre       String?
  foto_tipo_mime    String?
  foto_datos        Bytes?
  registrado_por_id Int?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  unidad            Unidad   @relation(fields: [unidad_id], references: [id], onDelete: Cascade)
  recibo            Recibo   @relation(fields: [recibo_id], references: [id], onDelete: Cascade)
  registrado_por    Usuario? @relation(fields: [registrado_por_id], references: [id], onDelete: SetNull)

  @@unique([unidad_id, recibo_id])
  @@index([recibo_id])
}

/// Imagen del recibo impreso: la foto de cabecera de un condominio o el logo de una empresa (uno por dueño). Aparte de sus tablas para que ningún
/// CRUD genérico arrastre los bytes.
model ImagenRecibo {
  id            Int                    @id @default(autoincrement())
  complejo_id   Int?                   @unique
  empresa_id    Int?                   @unique
  nombre        String
  tipo_mime     String
  tamano        Int
  datos         Bytes
  subido_por_id Int?
  created_at    DateTime               @default(now())
  updated_at    DateTime               @updatedAt
  complejo      ComplejoHabitacional?  @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  empresa       EmpresaAdministradora? @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  subido_por    Usuario?               @relation(fields: [subido_por_id], references: [id], onDelete: SetNull)
}

/// Lectura del comprobante por IA (visión) contrastada por código con lo que debía pagarse. Una por pago. No guarda el texto crudo del modelo.
model EvaluacionComprobante {
  id           Int       @id @default(autoincrement())
  pago_id      Int       @unique
  estado       String    @default("pendiente")
  proveedor    String?
  modelo       String?
  veredicto    String?
  confianza    Float?
  extraido     Json?
  coincidencias Json?
  alertas      Json?
  resumen      String?
  intentos     Int       @default(0)
  error        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  evaluada_at  DateTime?
  /// Cuándo se reintenta una evaluación «pendiente» que falló por algo transitorio. Lo toma el barrido periódico (con un claim atómico), así que
  /// sobrevive a un reinicio o deploy. Null = nada programado.
  reintentar_at DateTime?
  pago         Pago      @relation(fields: [pago_id], references: [id], onDelete: Cascade)

  @@index([estado, reintentar_at])
}

/// Modelo de chat que una clave puede usar (catálogo vivo, sincronizado con `GET /models` del proveedor). Nunca se borra: se depreca.
model ModeloIA {
  id           Int              @id @default(autoincrement())
  clave_id     Int
  clave        ClaveIntegracion @relation(fields: [clave_id], references: [id], onDelete: Cascade)
  modelo_id    String
  nombre       String?
  categoria    String           @default("equilibrado")
  estado       String           @default("nuevo")
  gratis       Boolean          @default(false)
  ventana      Int?
  vision       Boolean?
  visto_at     DateTime         @default(now())
  deprecado_at DateTime?
  created_at   DateTime         @default(now())

  @@unique([clave_id, modelo_id])
}

/// Historial de cada sincronización de modelos de una clave.
model SyncModelosIA {
  id         Int              @id @default(autoincrement())
  clave_id   Int
  clave      ClaveIntegracion @relation(fields: [clave_id], references: [id], onDelete: Cascade)
  ok         Boolean
  nuevos     Int              @default(0)
  deprecados Int              @default(0)
  revividos  Int              @default(0)
  total      Int              @default(0)
  detalle    Json?
  error      String?
  created_at DateTime         @default(now())

  @@index([clave_id, created_at])
}

/// Conversación del asistente. Su contenido sólo lo ve su dueño (ni el superadmin). Se borra a los 90 días.
model ConversacionIA {
  id         String      @id @default(cuid())
  usuario_id Int
  usuario    Usuario     @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  titulo     String
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  mensajes   MensajeIA[]

  @@index([usuario_id, updated_at])
}

model MensajeIA {
  id              Int            @id @default(autoincrement())
  conversacion_id String
  conversacion    ConversacionIA @relation(fields: [conversacion_id], references: [id], onDelete: Cascade)
  rol             String
  contenido       String
  proveedor       String?
  modelo          String?
  latencia_ms     Int?
  tokens_entrada  Int?
  tokens_salida   Int?
  estado          String         @default("ok")
  error_codigo    String?
  /// `contingencia` cuando la respuesta se armó por código porque ninguna ruta de IA respondió.
  modo            String?
  /// Herramientas de consulta que usó el turno: [{ nombre, ms, estado }]. Sin argumentos ni datos.
  herramientas    Json?
  created_at      DateTime       @default(now())

  @@index([conversacion_id, created_at])
  @@index([rol, created_at])
}

/// Estado persistente de la IA del asistente (salud, alertas): pares clave → JSON.
model EstadoIA {
  clave      String   @id
  valor      Json
  updated_at DateTime @updatedAt
}

/// Token de API personal de SOLO LECTURA para el endpoint MCP (`POST /mcp`). Se guarda sólo el sha256; el token se muestra una vez.
/// `huella` es un sha256 del rol y la contraseña del dueño al crearlo: si cualquiera cambia (o el usuario se desactiva), el token deja de valer.
model TokenApi {
  id          String    @id @default(cuid())
  usuario_id  Int
  usuario     Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  nombre      String
  prefijo     String
  hash        String    @unique
  huella      String
  ultimo_uso  DateTime?
  expira      DateTime
  revocado_at DateTime?
  created_at  DateTime  @default(now())

  @@index([usuario_id])
  @@index([prefijo])
}

// ---------- Bot por canal de mensajería (WhatsApp ahora, Telegram después) ----------

/// Vínculo verificado entre una persona de House y un identificador de un canal (celular E.164 o chat_id). Un identificador = UNA persona.
/// `clave_vigente` («canal:identificador») y `clave_usuario` («usuario:canal») son únicas MIENTRAS el vínculo está vigente y quedan en null al revocarlo
/// (Postgres permite varios null): así «único entre los vigentes» lo garantiza la base sin índices parciales.
model CanalVinculado {
  id              Int                   @id @default(autoincrement())
  usuario_id      Int
  usuario         Usuario               @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  canal           String
  identificador   String
  empresa_id      Int
  empresa         EmpresaAdministradora @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  verificado_at   DateTime
  revocado_at     DateTime?
  clave_vigente   String?               @unique
  clave_usuario   String?               @unique
  /// Conversación del asistente que se reutiliza para este vínculo (sin FK: la retención de 90 días puede borrarla).
  conversacion_id String?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  pendientes      CanalPendiente[]

  @@index([usuario_id, canal])
}

/// Código de un solo uso para vincular un canal: sólo se guarda su hash (sha256). Vence a los 10 minutos.
model CodigoVinculacion {
  id          Int       @id @default(autoincrement())
  usuario_id  Int
  usuario     Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  canal       String
  codigo_hash String
  expira_at   DateTime
  usado_at    DateTime?
  intentos    Int       @default(0)
  created_at  DateTime  @default(now())

  @@index([usuario_id, canal])
  @@index([codigo_hash])
}

/// Webhook que Evolution llama por empresa: sólo el hash (sha256) del secreto; el secreto en claro vive en la configuración de Evolution.
model CanalWebhook {
  id            Int                   @id @default(autoincrement())
  empresa_id    Int                   @unique
  empresa       EmpresaAdministradora @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  instancia     String                @unique
  secreto_hash  String
  url           String
  registrado_at DateTime              @default(now())
}

/// Mensajes de canal ya procesados (idempotencia: Evolution reintenta). Se limpian a los 7 días.
model MensajeCanal {
  id         Int      @id @default(autoincrement())
  instancia  String
  mensaje_id String
  created_at DateTime @default(now())

  @@unique([instancia, mensaje_id])
  @@index([created_at])
}

/// Voucher recibido por el canal que espera la respuesta «¿cuál pagaste?» (15 min). Guarda el archivo ya verificado.
model CanalPendiente {
  id         Int            @id @default(autoincrement())
  vinculo_id Int
  vinculo    CanalVinculado @relation(fields: [vinculo_id], references: [id], onDelete: Cascade)
  usuario_id Int
  usuario    Usuario        @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  /// [{ recibo_id, unidad_id, etiqueta }]
  opciones   Json
  nombre     String
  tipo_mime  String
  tamano     Int
  sha256     String
  datos      Bytes
  expira_at  DateTime
  created_at DateTime       @default(now())

  @@index([vinculo_id])
  @@index([expira_at])
}

// ---------- Comercial: planes, módulos por condominio y cobro manual de la suscripción ----------

/// Complemento que se vende por departamento al mes. Precio BASE (sin IGV). `activo`: se ofrece a la venta (no apaga a quien ya lo tiene).
model ModuloComercial {
  clave             String   @id
  nombre            String
  descripcion       String?
  precio_por_unidad Decimal  @default(0)
  activo            Boolean  @default(true)
  orden             Int      @default(0)
  updated_at        DateTime @updatedAt
}

/// Plan de la oferta (gratis, pro, administradora, cortesia). `precio_por_unidad` es BASE (sin IGV) salvo `igv_incluido`.
model PlanComercial {
  clave             String   @id
  nombre            String
  descripcion       String?
  precio_por_unidad Decimal  @default(0)
  /// Claves de `ModuloComercial` que el plan trae sin cobrar aparte.
  modulos_incluidos String[]
  /// Viñetas de la página de precios.
  caracteristicas   String[]
  /// true = `precio_por_unidad` ya trae el IGV; false (por defecto) = es el precio base y el IGV se suma.
  igv_incluido      Boolean  @default(false)
  visible           Boolean  @default(true)
  orden             Int      @default(0)
  /// Tope de unidades por condominio (Gratis = 20). null = sin tope. Crear unidades por encima falla; nunca se borra nada.
  unidades_maximas  Int?
  /// Unidades mínimas que se cobran por condominio (Pro y Administradora = 20): total = max(unidades, mínimo) × precio. null = sin mínimo.
  unidades_minimas  Int?
  /// Consultas al asistente de IA por departamento que se cobra, al mes (tope del condominio = esto × unidades cobradas). null = sin tope.
  asistente_por_unidad_mes Int?
  /// Mensajes de WhatsApp por departamento que se cobra, al mes (tope del condominio = esto × unidades cobradas). null = sin tope.
  whatsapp_por_unidad_mes  Int?
  updated_at        DateTime @updatedAt
}

/// Consumo del mes de un condominio en un recurso con tope (asistente de IA, WhatsApp). `periodo` es AAAAMM en hora de Lima; una fila por (condominio, mes, recurso).
model ConsumoMensual {
  id          Int                  @id @default(autoincrement())
  complejo_id Int
  complejo    ComplejoHabitacional @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  periodo     String
  recurso     String
  cantidad    Int                  @default(0)

  @@unique([complejo_id, periodo, recurso])
}

/// Suscripción de UN condominio. Sin fila = Gratis. Nunca se borran datos: vencida pasada la gracia sólo apaga los módulos.
model SuscripcionCondominio {
  id                    Int                  @id @default(autoincrement())
  complejo_id           Int                  @unique
  complejo              ComplejoHabitacional @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  plan_clave            String               @default("gratis")
  /// Módulos sueltos activos además de los que trae el plan.
  modulos               String[]
  /// gratis | solicitada | activa | por_vencer | vencida. El estado que manda para apagar módulos se calcula con `vigente_hasta` (ver services/comercial/estado.ts).
  estado                String               @default("gratis")
  /// Prueba de Pro al registrarse: al vencer vuelve a Gratis AL INSTANTE (sin gracia ni aviso de «vencida»). Pagar o cambiar el plan o la vigencia a mano la apaga.
  es_prueba             Boolean              @default(false)
  vigente_hasta         DateTime?
  solicitud_plan        String?
  solicitud_modulos     String[]
  solicitada_at         DateTime?
  notas                 String?
  /// Para el cobro con tarjeta que vendrá después (Culqi / Mercado Pago). Sin uso todavía.
  proveedor_pago        String?
  proveedor_ref         String?
  /// `vigente_hasta` para el que ya se envió cada aviso: evita repetirlo (idempotente por periodo).
  aviso_por_vencer_para DateTime?
  aviso_vencida_para    DateTime?
  aviso_apagada_para    DateTime?
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt

  @@index([estado])
}

/// Pago de la suscripción registrado a mano por el superadmin (transferencia, Yape…). Montos en soles; `monto` = base + IGV.
model PagoSuscripcion {
  id                Int                    @id @default(autoincrement())
  complejo_id       Int
  complejo          ComplejoHabitacional   @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  empresa_id        Int?
  empresa           EmpresaAdministradora? @relation(fields: [empresa_id], references: [id], onDelete: SetNull)
  monto_base        Decimal
  /// El impuesto del pago (IGV, IVA…): `impuesto_nombre` y `impuesto_tasa` son los que regían en el país del condominio al registrarlo.
  igv               Decimal
  monto             Decimal
  /// Moneda (ISO 4217) en la que se pagó, la del país del condominio al registrarlo. Un pago registrado ya no cambia.
  moneda            String                 @default("PEN")
  impuesto_nombre   String                 @default("IGV")
  impuesto_tasa     Decimal                @default(0.18)
  fecha_pago        DateTime
  medio             String
  operacion         String?
  periodo_desde     DateTime
  periodo_hasta     DateTime
  voucher_ref       String?
  notas             String?
  registrado_por_id Int?
  registrado_por    Usuario?               @relation("PagoSuscripcionRegistrador", fields: [registrado_por_id], references: [id], onDelete: SetNull)
  proveedor_pago    String?
  proveedor_ref     String?
  created_at        DateTime               @default(now())

  @@index([complejo_id, fecha_pago])
  @@index([empresa_id])
}

/// Fila única (id = 1): IGV, plazos y datos de pago que ve el cliente. Todo editable por el superadmin; nada va en variables de entorno.
model ConfiguracionComercial {
  id                     Int      @id
  igv_tasa               Decimal  @default(0.18)
  dias_gracia            Int      @default(7)
  dias_aviso_vencimiento Int      @default(5)
  /// A esta dirección llegan los avisos de registros nuevos y de solicitudes de plan.
  correo_superadmin      String?
  /// Base de los enlaces de los correos (https://…). Nunca se toma de la cabecera Host de la petición.
  url_publica            String?
  registro_abierto       Boolean  @default(true)
  /// Días de Pro de prueba que recibe cada condominio al registrarse (0 = sin prueba: nace en Gratis).
  dias_prueba_pro        Int      @default(30)
  /// Cuándo se dejaron en «cortesía» los condominios que ya existían al estrenar la capa comercial (una sola vez; ver services/comercial/migracion.ts).
  migracion_cortesia_at  DateTime?
  pago_titular           String?
  pago_banco             String?
  pago_cuenta            String?
  pago_cci               String?
  pago_yape              String?
  pago_instrucciones     String?
  /// Datos del responsable de House para la Política de privacidad y los Términos (Ley 29733). Nulos = «por confirmar» en esas páginas.
  legal_razon_social     String?
  legal_ruc              String?
  legal_domicilio        String?
  legal_correo           String?
  updated_at             DateTime @updatedAt
}

/// Impuesto y moneda con que se cobra la suscripción a House en un país (ISO 3166-1 alfa-2): IGV en Perú, IVA en Chile… Se siembra desde `src/lib/paises.ts`
/// (sólo CREA lo que falta) y el superadmin lo edita. `tasa` es fracción (0.18 = 18 %). `activo = false`: el país no se ofrece en /precios ni se puede contratar.
model ImpuestoPais {
  pais       String   @id
  nombre     String   @default("IGV")
  tasa       Decimal  @default(0)
  moneda     String   @default("PEN")
  activo     Boolean  @default(true)
  updated_at DateTime @updatedAt
}

/// Precio base (sin impuesto) por departamento al mes de un plan en una moneda. El precio en soles vive en `PlanComercial.precio_por_unidad`; esta tabla trae el
/// de las demás monedas. Un plan de pago sin fila en la moneda de un país no se puede contratar ahí («Consúltanos»).
model PrecioPlanMoneda {
  plan_clave        String
  moneda            String
  precio_por_unidad Decimal
  updated_at        DateTime @updatedAt

  @@id([plan_clave, moneda])
}

/// Enlace de un solo uso para verificar el correo del registro público. Sólo se guarda el hash del token.
model TokenVerificacionCorreo {
  id         Int       @id @default(autoincrement())
  usuario_id Int
  usuario    Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  expira_at  DateTime
  usado_at   DateTime?
  created_at DateTime  @default(now())

  @@index([usuario_id])
}

/// Invitación para crear la contraseña de un usuario dado de alta SIN contraseña. Un solo uso, vence a los 7 días. Sólo se guarda el hash del token.
model TokenInvitacion {
  id            Int       @id @default(autoincrement())
  usuario_id    Int
  usuario       Usuario   @relation("InvitacionDeUsuario", fields: [usuario_id], references: [id], onDelete: Cascade)
  token_hash    String    @unique
  expira_at     DateTime
  usado_at      DateTime?
  created_at    DateTime  @default(now())
  /// Quién invitó (el administrador o superadmin que creó o reenvió); si esa cuenta se borra queda en null.
  creado_por_id Int?
  creado_por    Usuario?  @relation("InvitacionCreadaPor", fields: [creado_por_id], references: [id], onDelete: SetNull)

  @@index([usuario_id])
}

/// Cierre del mes de un block: una línea por lo que la junta del block paga ese mes (a la empresa administradora, a la Junta central, agua y luz por la boleta,
/// proveedores por la factura). `linea` = `administradora` | `central` | `concepto:<id>`; una sola fila por (block, año, mes, línea) (la unicidad la impone el
/// índice). `facturado` es lo facturado al block al registrar (foto); `monto_pagado` lo que de verdad se pagó. La conformidad («llegó a la cuenta») la da la
/// administración en la línea `administradora` y el tesorero central en la línea `central`; servicios y proveedores no la llevan.
model EgresoBlock {
  id                 Int                  @id @default(autoincrement())
  complejo_id        Int
  estructura_id      Int
  mes                Int
  anio               Int
  linea              String
  destino            String
  concepto_id        Int?
  proveedor_id       Int?
  facturado          Decimal
  monto_pagado       Decimal
  /// Fecha de calendario (00:00 UTC) del pago.
  fecha_pago         DateTime             @db.Date
  referencia         String?
  observaciones      String?
  registrado_por_id  Int?
  conformidad_at     DateTime?
  conformidad_por_id Int?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  complejo           ComplejoHabitacional @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  estructura         Estructura           @relation(fields: [estructura_id], references: [id], onDelete: Cascade)
  concepto           Concepto?            @relation(fields: [concepto_id], references: [id], onDelete: SetNull)
  proveedor          Proveedor?           @relation(fields: [proveedor_id], references: [id], onDelete: SetNull)
  registrado_por     Usuario?             @relation("EgresoRegistrador", fields: [registrado_por_id], references: [id], onDelete: SetNull)
  conformidad_por    Usuario?             @relation("EgresoConformidad", fields: [conformidad_por_id], references: [id], onDelete: SetNull)
  voucher            ArchivoEgresoBlock?

  @@unique([estructura_id, anio, mes, linea])
  @@index([complejo_id, anio, mes])
}

/// Voucher (imagen o PDF) del pago de una línea del cierre. Sólo por su endpoint con alcance.
model ArchivoEgresoBlock {
  id            Int         @id @default(autoincrement())
  egreso_id     Int         @unique
  nombre        String
  tipo_mime     String
  tamano        Int
  sha256        String
  datos         Bytes
  subido_por_id Int?
  created_at    DateTime    @default(now())
  egreso        EgresoBlock @relation(fields: [egreso_id], references: [id], onDelete: Cascade)
}

/// Cierre de la Junta central: lo que entra y sale de su cuenta además de los aportes de los blocks (esos salen de `EgresoBlock` con destino `central` y conformidad del
/// tesorero central). `tipo` = `ingreso` | `egreso`; `categoria` = `alquiler_estacionamiento` | `otro_ingreso` (ingresos) o `servicio` | `proveedor` | `otro_egreso`
/// (egresos). `mes`/`anio` es el mes del cierre al que cuenta (en un alquiler, el periodo alquilado). `pagador` = quién paga (vecino o externo, texto libre) y
/// `estacionamiento` sólo en el alquiler; `documento` = n.º de la boleta o la factura. El voucher es obligatorio (`ArchivoMovimientoCentral`).
model MovimientoCentral {
  id                Int                  @id @default(autoincrement())
  complejo_id       Int
  tipo              String
  categoria         String
  mes               Int
  anio              Int
  descripcion       String?
  pagador           String?
  estacionamiento   String?
  proveedor_id      Int?
  documento         String?
  monto             Decimal
  /// Fecha de calendario (00:00 UTC) del cobro o del pago.
  fecha             DateTime             @db.Date
  referencia        String?
  observaciones     String?
  registrado_por_id Int?
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt
  complejo          ComplejoHabitacional @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  proveedor         Proveedor?           @relation(fields: [proveedor_id], references: [id], onDelete: SetNull)
  registrado_por    Usuario?             @relation(fields: [registrado_por_id], references: [id], onDelete: SetNull)
  voucher           ArchivoMovimientoCentral?

  @@index([complejo_id, anio, mes])
}

/// Voucher (imagen o PDF) de un movimiento de la Junta central. Sólo por su endpoint con alcance.
model ArchivoMovimientoCentral {
  id            Int               @id @default(autoincrement())
  movimiento_id Int               @unique
  nombre        String
  tipo_mime     String
  tamano        Int
  sha256        String
  datos         Bytes
  subido_por_id Int?
  created_at    DateTime          @default(now())
  movimiento    MovimientoCentral @relation(fields: [movimiento_id], references: [id], onDelete: Cascade)
}
