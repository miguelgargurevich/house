generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TareaMantenimiento {
  id             Int       @id @default(autoincrement())
  titulo         String
  descripcion    String?
  estado         String    @default("pendiente")
  unidad_id      Int?
  asignado_id    Int?
  /// Alternativa a `asignado_id`: la tarea la hace un proveedor externo (directorio de la administradora).
  proveedor_id   Int?
  creado_por_id  Int?
  fecha_creacion DateTime  @default(now())
  fecha_cierre   DateTime?
  proveedor      Proveedor? @relation(fields: [proveedor_id], references: [id], onDelete: SetNull)
  asignado       Usuario?  @relation("TareaAsignado", fields: [asignado_id], references: [id])
  creado_por     Usuario?  @relation("TareaCreador", fields: [creado_por_id], references: [id])
  unidad         Unidad?   @relation(fields: [unidad_id], references: [id])
}

model Usuario {
  id                Int                    @id @default(autoincrement())
  nombre            String
  email             String                 @unique
  telefono          String?
  rol               String?
  password_hash     String?
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  pagos             Pago[]                 @relation("PagoUsuario")
  recibosCreados    Recibo[]               @relation("UsuarioCreadorRecibo")
  tareasAsignadas   TareaMantenimiento[]   @relation("TareaAsignado")
  tareasCreadas     TareaMantenimiento[]   @relation("TareaCreador")
  unidades          Unidad[]               @relation("PropietarioUnidad")
  unidadesInquilino Unidad[]               @relation("InquilinoUnidad")
  auditorias        Auditoria[]
  clavesIntegracion ClaveIntegracion[]
  sesiones          Sesion[]
  empresa_id        Int?
  empresa           EmpresaAdministradora? @relation(fields: [empresa_id], references: [id])
  complejo_id       Int?
  complejo          ComplejoHabitacional?  @relation(fields: [complejo_id], references: [id])
  pagosValidados    Pago[]                 @relation("PagoValidador")
  comprobantesSubidos ArchivoComprobante[]
  aviso_email       Boolean                @default(true)
  aviso_whatsapp    Boolean                @default(false)
  notificaciones    Notificacion[]
  cargo_junta       String?
  estructura_id     Int?
  estructura        Estructura?            @relation("JuntaEstructura", fields: [estructura_id], references: [id], onDelete: SetNull)
  mediosPagoCreados MedioPago[]
  conversacionesIA  ConversacionIA[]
  tokensApi         TokenApi[]
}

model EmpresaAdministradora {
  id                  Int                    @id @default(autoincrement())
  nombre              String
  ruc                 String?
  direccion           String?
  telefono            String?
  email               String?
  representante_legal String?
  fecha_inicio        DateTime?
  fecha_fin           DateTime?
  estado              String?                @default("activa")
  whatsapp_instance   String?
  whatsapp_token      String?
  complejos           ComplejoHabitacional[]
  contratos           ContratoAdministracion[]
  proveedores         Proveedor[]
  conceptos           Concepto[]
  recibos             Recibo[]
  unidades            Unidad[]
  usuarios            Usuario[]
}

model ComplejoHabitacional {
  id          Int                    @id @default(autoincrement())
  nombre      String
  tipo        String
  direccion   String?
  empresa_id  Int?
  descripcion String?
  empresa     EmpresaAdministradora? @relation(fields: [empresa_id], references: [id])
  estructuras Estructura[]
  recibos     Recibo[]
  unidades    Unidad[]
  usuarios    Usuario[]
  mediosPago  MedioPago[]
  contratos   ContratoAdministracion[]
  proveedores ProveedorComplejo[]
  /// Si está activa, un comprobante que la IA lee como «coincide» (confianza alta, sin duplicados) valida el pago solo. Nunca rechaza.
  validacion_automatica_ia Boolean @default(false)
}

/// Quién administra un condominio y desde cuándo. Un solo contrato vigente (`fecha_fin` null) por condominio; `ComplejoHabitacional.empresa_id` es la empresa de ese contrato.
model ContratoAdministracion {
  id            Int                   @id @default(autoincrement())
  complejo_id   Int
  empresa_id    Int
  fecha_inicio  DateTime
  fecha_fin     DateTime?
  observaciones String?
  created_at    DateTime              @default(now())
  complejo      ComplejoHabitacional  @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  empresa       EmpresaAdministradora @relation(fields: [empresa_id], references: [id])

  @@index([complejo_id, fecha_fin])
  @@index([empresa_id])
}

/// Proveedor externo de la administradora (ascensores, gasfitería, pintura…). Sólo ficha: no inicia sesión. Se asigna a tareas de mantenimiento.
model Proveedor {
  id              Int                    @id @default(autoincrement())
  empresa_id      Int
  razon_social    String
  ruc             String?
  rubro           String
  contacto_nombre String?
  telefono        String?
  email           String?
  notas           String?
  activo          Boolean                @default(true)
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt
  empresa         EmpresaAdministradora  @relation(fields: [empresa_id], references: [id])
  complejos       ProveedorComplejo[]
  tareas          TareaMantenimiento[]

  @@index([empresa_id, rubro])
}

/// Condominios que atiende un proveedor.
model ProveedorComplejo {
  proveedor_id Int
  complejo_id  Int
  proveedor    Proveedor            @relation(fields: [proveedor_id], references: [id], onDelete: Cascade)
  complejo     ComplejoHabitacional @relation(fields: [complejo_id], references: [id], onDelete: Cascade)

  @@id([proveedor_id, complejo_id])
}

model Estructura {
  id          Int                   @id @default(autoincrement())
  nombre      String?
  tipo        String
  padre_id    Int?
  complejo_id Int?
  created_at  DateTime              @default(now())
  updated_at  DateTime              @updatedAt
  complejo    ComplejoHabitacional? @relation(fields: [complejo_id], references: [id])
  padre       Estructura?           @relation("EstructuraPadre", fields: [padre_id], references: [id])
  hijos       Estructura[]          @relation("EstructuraPadre")
  pisos       Piso[]
  unidades    Unidad[]
  juntaUsuarios Usuario[]           @relation("JuntaEstructura")
  mediosPago  MedioPago[]
}

model Piso {
  id            Int         @id @default(autoincrement())
  numero        Int?
  estructura_id Int?
  estructura    Estructura? @relation(fields: [estructura_id], references: [id])
  unidades      Unidad[]
}

model Unidad {
  id                     Int                    @id @default(autoincrement())
  codigo                 String
  tipo                   String
  estructura_id          Int?
  piso_id                Int?
  complejo_id            Int?
  descripcion            String?
  propietario_id         Int?
  inquilino_id           Int?
  empresa_id             Int?
  estado                 String?                @default("activa")
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  reciboConceptoUnidades ReciboConceptoUnidad[]
  tareasMantenimiento    TareaMantenimiento[]
  complejo               ComplejoHabitacional?  @relation(fields: [complejo_id], references: [id])
  empresa                EmpresaAdministradora? @relation(fields: [empresa_id], references: [id])
  estructura             Estructura?            @relation(fields: [estructura_id], references: [id])
  piso                   Piso?                  @relation(fields: [piso_id], references: [id])
  propietario            Usuario?               @relation("PropietarioUnidad", fields: [propietario_id], references: [id])
  inquilino              Usuario?               @relation("InquilinoUnidad", fields: [inquilino_id], references: [id])
}

model Concepto {
  id              Int                    @id @default(autoincrement())
  nombre          String
  descripcion     String?
  tipo_monto      String?                @default("fijo")
  empresa_id      Int?
  activo          Boolean                @default(true)
  created_at      DateTime               @default(now())
  updated_at      DateTime               @updatedAt
  empresa         EmpresaAdministradora? @relation(fields: [empresa_id], references: [id])
  reciboConceptos ReciboConcepto[]
}

model Recibo {
  id                Int                    @id @default(autoincrement())
  descripcion       String?
  fecha_emision     DateTime
  fecha_vencimiento DateTime
  mes               Int
  anio              Int
  estado            String?                @default("emitido")
  empresa_id        Int?
  complejo_id       Int?
  archivo_excel_url String?
  creado_por_id     Int?
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt
  complejo          ComplejoHabitacional?  @relation(fields: [complejo_id], references: [id])
  creado_por        Usuario?               @relation("UsuarioCreadorRecibo", fields: [creado_por_id], references: [id])
  empresa           EmpresaAdministradora? @relation(fields: [empresa_id], references: [id])
  reciboConceptos   ReciboConcepto[]
}

model ReciboConcepto {
  id                     Int                    @id @default(autoincrement())
  recibo_id              Int?
  concepto_id            Int?
  monto                  Decimal
  es_recargo             Boolean                @default(false)
  orden                  Int?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  concepto               Concepto?              @relation(fields: [concepto_id], references: [id])
  recibo                 Recibo?                @relation(fields: [recibo_id], references: [id])
  reciboConceptoUnidades ReciboConceptoUnidad[]
}

model ReciboConceptoUnidad {
  id                 Int             @id @default(autoincrement())
  recibo_concepto_id Int?
  unidad_id          Int?
  monto              Decimal
  estado_pago        String?         @default("pendiente")
  fecha_pago         DateTime?
  url_voucher        String?
  observaciones      String?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  pagos              Pago[]
  reciboConcepto     ReciboConcepto? @relation(fields: [recibo_concepto_id], references: [id])
  unidad             Unidad?         @relation(fields: [unidad_id], references: [id])
}

model Pago {
  id                        Int                   @id @default(autoincrement())
  recibo_concepto_unidad_id Int?
  monto                     Decimal
  fecha_pago                DateTime              @default(now())
  usuario_id                Int?
  metodo_pago               String?
  referencia                String?
  observaciones             String?
  created_at                DateTime              @default(now())
  reciboConceptoUnidad      ReciboConceptoUnidad? @relation(fields: [recibo_concepto_unidad_id], references: [id])
  usuario                   Usuario?              @relation("PagoUsuario", fields: [usuario_id], references: [id])
  estado_validacion         String                @default("validado")
  validado_por_id           Int?
  validado_at               DateTime?
  motivo_rechazo            String?
  validado_por              Usuario?              @relation("PagoValidador", fields: [validado_por_id], references: [id], onDelete: SetNull)
  comprobante               ArchivoComprobante?
  validado_por_ia           Boolean               @default(false)
  evaluacion                EvaluacionComprobante?
  /// Pago del mantenimiento completo: los `Pago` de un mismo (recibo, unidad) comparten este identificador. Null = pago suelto por cargo.
  grupo                     String?
  /// El pago que representa al grupo: lleva el comprobante y la evaluación de la IA (que compara contra el TOTAL del grupo).
  grupo_principal           Boolean               @default(false)

  @@index([estado_validacion])
  @@index([grupo])
}

model Auditoria {
  id         Int      @id @default(autoincrement())
  usuario_id Int?
  accion     String
  entidad    String
  entidad_id Int?
  detalle    Json?
  ip         String?
  created_at DateTime @default(now())
  usuario    Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([entidad, accion])
  @@index([usuario_id])
  @@index([created_at])
}

model ClaveIntegracion {
  id                Int       @id @default(autoincrement())
  proveedor         String
  etiqueta          String    @default("principal")
  api_key_enc       String
  ultimos4          String
  modelo            String?
  habilitada        Boolean   @default(true)
  estado            String    @default("sin_probar")
  estado_detalle    String?
  probada_at        DateTime?
  ultimo_uso_at     DateTime?
  actualizado_por_id Int?
  actualizado_por   Usuario?  @relation(fields: [actualizado_por_id], references: [id], onDelete: SetNull)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  /// Proveedor «de reserva»: sólo se usa cuando las rutas normales están agotadas.
  reserva           Boolean   @default(false)
  /// Aviso para la pantalla cuando el modelo fijado dejó de existir y la clave volvió a elección automática.
  aviso_modelo      String?
  modelos           ModeloIA[]
  sincronizaciones  SyncModelosIA[]

  @@unique([proveedor, etiqueta])
}

/// Sesión del lado del servidor: la cookie `house_sesion` lleva un token opaco; aquí sólo se guarda su sha256.
model Sesion {
  id            String    @id @default(cuid())
  usuario_id    Int
  usuario       Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  token_hash    String    @unique
  csrf_token    String
  ip            String?
  user_agent    String?
  created_at    DateTime  @default(now())
  ultimo_uso_at DateTime  @default(now())
  expira_at     DateTime
  revocada_at   DateTime?

  @@index([usuario_id])
  @@index([expira_at])
}

model ArchivoComprobante {
  id             Int      @id @default(autoincrement())
  pago_id        Int      @unique
  nombre         String
  tipo_mime      String
  tamano         Int
  sha256         String
  datos          Bytes
  subido_por_id  Int?
  created_at     DateTime @default(now())
  pago           Pago     @relation(fields: [pago_id], references: [id], onDelete: Cascade)
  subido_por     Usuario? @relation(fields: [subido_por_id], references: [id], onDelete: SetNull)
}

/// Aviso por correo o WhatsApp: se encola `pendiente` y el planificador lo envía. Único por usuario, canal, tipo y referencia.
model Notificacion {
  id             Int       @id @default(autoincrement())
  usuario_id     Int
  canal          String
  tipo           String
  asunto         String
  cuerpo         String
  estado         String    @default("pendiente")
  intentos       Int       @default(0)
  error          String?
  programada_para DateTime @default(now())
  enviada_at     DateTime?
  ref_entidad    String?
  ref_id         Int?
  created_at     DateTime  @default(now())
  usuario        Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([usuario_id, canal, tipo, ref_entidad, ref_id])
  @@index([estado, programada_para])
  @@index([usuario_id])
  @@index([created_at])
}

/// Cuenta bancaria, Yape/Plin (con QR) o cuenta recaudadora (el vecino paga desde «Pago de servicios» de su banco) donde los vecinos pagan; la define la administradora o la junta del block.
model MedioPago {
  id                Int                   @id @default(autoincrement())
  complejo_id       Int
  estructura_id     Int?
  tipo              String
  banco             String?
  /// Nombre de la entidad cuando `banco` es «Otro» (obligatorio al crear o editar; un medio antiguo puede no tenerlo).
  banco_otro        String?
  tipo_cuenta       String?
  numero_cuenta     String?
  cci               String?
  /// PEN | USD. Sólo informa al vecino: nada se convierte.
  moneda            String                @default("PEN")
  /// Recaudación: nombre del servicio tal como aparece en «Pago de servicios» de la app del banco.
  servicio          String?
  /// Recaudación: qué código escribe el vecino: departamento | dni | otro.
  codigo_pago       String?
  /// Recaudación con `codigo_pago = otro`: qué debe escribir el vecino.
  codigo_instruccion String?
  titular           String
  documento_titular String?
  celular           String?
  qr_nombre         String?
  qr_tipo_mime      String?
  qr_datos          Bytes?
  activo            Boolean               @default(true)
  orden             Int                   @default(0)
  creado_por_id     Int?
  created_at        DateTime              @default(now())
  updated_at        DateTime              @updatedAt
  complejo          ComplejoHabitacional  @relation(fields: [complejo_id], references: [id], onDelete: Cascade)
  estructura        Estructura?           @relation(fields: [estructura_id], references: [id], onDelete: Cascade)
  creado_por        Usuario?              @relation(fields: [creado_por_id], references: [id], onDelete: SetNull)

  @@index([complejo_id, estructura_id])
}

/// Lectura del comprobante por IA (visión) contrastada por código con lo que debía pagarse. Una por pago. No guarda el texto crudo del modelo.
model EvaluacionComprobante {
  id           Int       @id @default(autoincrement())
  pago_id      Int       @unique
  estado       String    @default("pendiente")
  proveedor    String?
  modelo       String?
  veredicto    String?
  confianza    Float?
  extraido     Json?
  coincidencias Json?
  alertas      Json?
  resumen      String?
  intentos     Int       @default(0)
  error        String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  evaluada_at  DateTime?
  pago         Pago      @relation(fields: [pago_id], references: [id], onDelete: Cascade)
}

/// Modelo de chat que una clave puede usar (catálogo vivo, sincronizado con `GET /models` del proveedor). Nunca se borra: se depreca.
model ModeloIA {
  id           Int              @id @default(autoincrement())
  clave_id     Int
  clave        ClaveIntegracion @relation(fields: [clave_id], references: [id], onDelete: Cascade)
  modelo_id    String
  nombre       String?
  categoria    String           @default("equilibrado")
  estado       String           @default("nuevo")
  gratis       Boolean          @default(false)
  ventana      Int?
  vision       Boolean?
  visto_at     DateTime         @default(now())
  deprecado_at DateTime?
  created_at   DateTime         @default(now())

  @@unique([clave_id, modelo_id])
}

/// Historial de cada sincronización de modelos de una clave.
model SyncModelosIA {
  id         Int              @id @default(autoincrement())
  clave_id   Int
  clave      ClaveIntegracion @relation(fields: [clave_id], references: [id], onDelete: Cascade)
  ok         Boolean
  nuevos     Int              @default(0)
  deprecados Int              @default(0)
  revividos  Int              @default(0)
  total      Int              @default(0)
  detalle    Json?
  error      String?
  created_at DateTime         @default(now())

  @@index([clave_id, created_at])
}

/// Conversación del asistente. Su contenido sólo lo ve su dueño (ni el superadmin). Se borra a los 90 días.
model ConversacionIA {
  id         String      @id @default(cuid())
  usuario_id Int
  usuario    Usuario     @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  titulo     String
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  mensajes   MensajeIA[]

  @@index([usuario_id, updated_at])
}

model MensajeIA {
  id              Int            @id @default(autoincrement())
  conversacion_id String
  conversacion    ConversacionIA @relation(fields: [conversacion_id], references: [id], onDelete: Cascade)
  rol             String
  contenido       String
  proveedor       String?
  modelo          String?
  latencia_ms     Int?
  tokens_entrada  Int?
  tokens_salida   Int?
  estado          String         @default("ok")
  error_codigo    String?
  /// `contingencia` cuando la respuesta se armó por código porque ninguna ruta de IA respondió.
  modo            String?
  /// Herramientas de consulta que usó el turno: [{ nombre, ms, estado }]. Sin argumentos ni datos.
  herramientas    Json?
  created_at      DateTime       @default(now())

  @@index([conversacion_id, created_at])
  @@index([rol, created_at])
}

/// Estado persistente de la IA del asistente (salud, alertas): pares clave → JSON.
model EstadoIA {
  clave      String   @id
  valor      Json
  updated_at DateTime @updatedAt
}

/// Token de API personal de SOLO LECTURA para el endpoint MCP (`POST /mcp`). Se guarda sólo el sha256; el token se muestra una vez.
/// `huella` es un sha256 del rol y la contraseña del dueño al crearlo: si cualquiera cambia (o el usuario se desactiva), el token deja de valer.
model TokenApi {
  id          String    @id @default(cuid())
  usuario_id  Int
  usuario     Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  nombre      String
  prefijo     String
  hash        String    @unique
  huella      String
  ultimo_uso  DateTime?
  expira      DateTime
  revocado_at DateTime?
  created_at  DateTime  @default(now())

  @@index([usuario_id])
  @@index([prefijo])
}
