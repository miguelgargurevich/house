# Copia a .env (no se commitea). Nunca pegues valores reales aquí.
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5433/house

# Obligatorio en producción (NODE_ENV=production): mínimo 32 caracteres aleatorios.
# En desarrollo, si falta, se usa un secreto aleatorio por proceso (las sesiones se pierden al reiniciar).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opcional: orígenes permitidos por CORS, separados por comas. Vacío = CORS desactivado (mismo origen).
# En desarrollo el proxy de Vite hace innecesario CORS.
CORS_ORIGIN=

# Opcional: clave del chat de IA (Gemini).
GEMINI_API_KEY=

# Opcional
PORT=4000

# Avisos por correo (Resend, https://resend.com): sin ambas variables los avisos por correo quedan «omitidos».
# MAIL_FROM debe ser de un dominio verificado en Resend, p. ej. "Casa <avisos@tudominio.pe>".
RESEND_API_KEY=
MAIL_FROM=

# Avisos por WhatsApp (Evolution API del VPS): sin las tres variables quedan «omitidos».
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=

# Planificador de avisos (recordatorios por vencer / vencido y cola de envío): on | off.
# Sin definir, queda activo solo con NODE_ENV=production.
AVISOS_PLANIFICADOR=

# Llavero de IA (superadmin): clave maestra con la que se cifran en reposo las API keys de proveedores (AES-256-GCM).
# Mínimo 32 caracteres aleatorios. Sin ella el llavero responde 503 y no guarda nada; la app sigue arrancando.
# Si la cambias, las claves guardadas dejan de descifrarse (hay que volver a cargarlas).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
LLAVERO_ENC_KEY=

# Asistente de IA (todas on | off; sin definir quedan activas solo con NODE_ENV=production):
#   MODELOS_SYNC       descubre y depreca modelos de cada clave (al guardarla y cada 6 h) y recupera claves rechazadas
#   ASISTENTE_CANARY   consulta mínima periódica (cada 30 min, máx. 50 al día) para detectar un proveedor caído antes que los vecinos
#   ASISTENTE_LIMPIEZA borra las conversaciones con más de 90 días sin actividad
MODELOS_SYNC=
ASISTENTE_CANARY=
ASISTENTE_LIMPIEZA=
# Opcionales: rutas (proveedor+modelo) distintas por consulta (1–8, por omisión 6) y tope de tiempo total por consulta en ms (por omisión 25000).
LLAVERO_MAX_INTENTOS=
LLAVERO_TOPE_MS=

# Herramientas de consulta del asistente (solo lectura; ver docs/HERRAMIENTAS.md): `off` las apaga (vuelve al contexto fijo).
# Opcional: tiempo total por turno en rondas de herramientas, en ms (3000–60000, por omisión 20000).
ASISTENTE_HERRAMIENTAS=
ASISTENTE_HERRAMIENTAS_MS=

# Desarrollo con Vite (localhost:5173 hace proxy a la API): hace falta declarar ese origen o las mutaciones
# (POST/PUT/PATCH/DELETE) responden 403 «el origen no coincide». En producción NO se define (mismo origen).
# CORS_ORIGIN=http://localhost:5173
